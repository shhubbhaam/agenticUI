import { ApiError, request } from './client';
import { userSessionSchema, type UserSession } from './schemas';

// All auth goes through the BFF (bff/src/app.ts). It checks the credentials with LearnHouse, keeps any
// LearnHouse token server-side, and returns an opaque session token for this app.
interface BffLogin {
  token?: unknown;
}

function sessionToken(data: BffLogin | undefined, what: string): string {
  if (typeof data?.token !== 'string' || data.token.length === 0) {
    throw new ApiError(0, `${what} succeeded but no session token was returned`);
  }
  return data.token;
}

export async function loginWithPassword(email: string, password: string): Promise<string> {
  const data = await request<BffLogin>('/auth/login', { method: 'POST', json: { email, password } });
  return sessionToken(data, 'Login');
}

export async function exchangeGoogleToken(email: string, googleAccessToken: string): Promise<string> {
  const data = await request<BffLogin>('/auth/google', {
    method: 'POST',
    json: { email, accessToken: googleAccessToken },
  });
  return sessionToken(data, 'Google sign-in');
}

/** The signed-in learner, in LearnHouse's /users/session shape, limited to this app's org. */
export async function fetchSession(token: string): Promise<UserSession> {
  const data = await request('/me', { token });
  return userSessionSchema.parse(data);
}

export async function logout(token: string): Promise<void> {
  try {
    await request('/auth/logout', { method: 'POST', token });
  } catch {
    // Best-effort — the local session is cleared regardless (see
    // useSessionStore.signOut), so a failed server-side invalidation
    // shouldn't block the user from logging out on-device.
  }
}
</file>

<file path="src/data/learnhouse/client.ts">
// Thin fetch wrapper for the app's backend-for-frontend (bff/). The app never calls LearnHouse
// directly: the BFF holds the org API token server-side and derives the learner from an opaque
// session token, sent as `Authorization: Bearer`. (W2 review P0: no org token in the bundle.)

export class ApiError extends Error {
  status: number;

  constructor(status: number, message: string) {
    super(message);
    this.status = status;
    this.name = 'ApiError';
  }
}

interface RequestOptions {
  method?: 'GET' | 'POST' | 'PUT' | 'DELETE';
  token?: string | null;
  json?: unknown;
  form?: Record<string, string>;
}

function extractErrorMessage(status: number, data: unknown): string {
  if (data && typeof data === 'object' && 'detail' in data) {
    const detail = (data as { detail: unknown }).detail;
    if (typeof detail === 'string') return detail;
    if (Array.isArray(detail) && detail.length > 0 && typeof detail[0]?.msg === 'string') {
      return detail[0].msg;
    }
  }
  return `Request failed with status ${status}`;
}

export async function request<T = unknown>(path: string, options: RequestOptions = {}): Promise<T> {
  // e.g. http://10.0.2.2:3000/api on the Android emulator. Read per call so tests can set it.
  const rawBaseUrl = process.env.EXPO_PUBLIC_BFF_URL;
  if (!rawBaseUrl) {
    throw new ApiError(0, 'EXPO_PUBLIC_BFF_URL is not configured');
  }
  // Strip trailing slashes so `${baseUrl}${path}` (path always starts with
  // `/`) can't produce a silent double slash for a URL copied with one.
  let baseUrl = rawBaseUrl;
  while (baseUrl.endsWith('/')) {
    baseUrl = baseUrl.slice(0, -1);
  }

  const { method = 'GET', token, json, form } = options;
  const headers: Record<string, string> = {};
  let body: string | undefined;

  if (form) {
    body = new URLSearchParams(form).toString();
    headers['Content-Type'] = 'application/x-www-form-urlencoded';
  } else if (json !== undefined) {
    body = JSON.stringify(json);
    headers['Content-Type'] = 'application/json';
  }
  if (token) {
    headers.Authorization = `Bearer ${token}`;
  }

  let response: Response;
  try {
    response = await fetch(`${baseUrl}${path}`, { method, headers, body });
  } catch {
    throw new ApiError(0, 'Network request failed');
  }

  let data: unknown;
  try {
    data = await response.json();
  } catch {
    data = undefined;
  }

  if (!response.ok) {
    throw new ApiError(response.status, extractErrorMessage(response.status, data));
  }

  return data as T;
}
