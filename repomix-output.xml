# bff/.env.example — copy to bff/.env (git-ignored). Server-only secrets live here.
PORT=3000
# NOTE: no LH_USER_ID here on purpose. The learner id comes from LearnHouse login
# (POST /auth/login, fallback GET /users/profile) and is stored in the BFF session.
# Pinned LearnHouse instance (record the release/commit in docs/W3-plan-and-evidence.md)
# Host + /api/v1, no trailing slash (the old script took host only)
LH_BASE_URL=http://localhost:1338/api/v1
LH_ORG_SLUG=your-org-slug
LH_API_TOKEN=replace-with-org-api-token
# Comma-separated course UUIDs learners may open through this BFF
LH_ALLOWED_COURSES=course_xxxxxxxx
# Optional. Without it the BFF serves the deterministic LearnHouse-derived layout.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- DEV ONLY: use while LearnHouse /auth/login is not working ----
# Log in from the app with one of these emails + LH_DEV_PASSWORD.
