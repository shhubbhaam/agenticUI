import React from 'react';
import { View, Text, TouchableOpacity, ScrollView } from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import tw from 'twrnc';
import { colors } from '../../ui/tokens/colors';
import { typography } from '../../ui/tokens/typography';
import { ActiveButton } from '../../ui/atoms/ActiveButton';
import { Icon } from '../../ui/atoms/Icon';
import { StageCrest } from '../../ui/atoms/roadmap/StageCrest';
import { Alert } from '../../ui/molecules/Alert';
import { TextField } from './TextField';
import { useLoginFlow, type Provider } from './useLoginFlow';

const PROVIDER_LABEL: Record<Provider, string> = {
  google: 'Continue with Google',
  linkedin: 'Continue with LinkedIn',
  org: 'Sign in with your organization',
};

function GhostLink({ label, onPress, compact = false }: { label: string; onPress: () => void; compact?: boolean }) {
  return (
    <TouchableOpacity onPress={onPress} style={compact ? tw`items-start` : tw`items-center py-3`}>
      <Text
        style={{
          fontFamily: typography.fontFamily['jakarta-bold'],
          color: colors.action.ghost,
          ...(compact ? typography.fontSize['type-12'] : typography.fontSize['type-14-base']),
        }}
      >
        {label}
      </Text>
    </TouchableOpacity>
  );
}

function Footer() {
  return (
    <Text style={[tw`text-center mt-4`, { fontFamily: typography.fontFamily.jakarta, color: colors.eyebrow.ink, ...typography.fontSize['type-12-base'] }]}>
      By continuing, you agree to our{' '}
      <Text style={{ fontFamily: typography.fontFamily['jakarta-bold'], color: colors.path.linkInk, ...typography.fontSize['type-13-alt'] }}>Terms</Text>
      {' '}and{' '}
      <Text style={{ fontFamily: typography.fontFamily['jakarta-bold'], color: colors.path.linkInk, ...typography.fontSize['type-13-alt'] }}>Privacy Policy</Text>.
    </Text>
  );
}

export default function LoginScreen() {
  const flow = useLoginFlow();

  return (
    <SafeAreaView style={[tw`flex-1`, { backgroundColor: colors.surface.canvas }]} edges={['top']}>
      <ScrollView contentContainerStyle={tw`px-5 pt-9 pb-8`} keyboardShouldPersistTaps="handled">
        <View style={tw`flex-row items-center gap-2 mb-8`}>
          <View
            style={[
              tw`items-center justify-center rounded-xl`,
              { width: 39, height: 42, backgroundColor: colors.hero.brandMark.surface },
            ]}
          >
            <Text style={{ fontFamily: typography.fontFamily['jakarta-extrabold'], color: colors.text.primary, ...typography.fontSize['type-25-alt'] }}>Λ</Text>
          </View>
          <Text style={{ fontFamily: typography.fontFamily['jakarta-bold'], color: colors.text.primary, ...typography.fontSize['type-15'] }}>AI Launchpad</Text>
        </View>

        <Text style={[tw`mb-1`, { fontFamily: typography.fontFamily['jakarta-bold'], color: colors.eyebrow.ink, ...typography.fontSize['type-11-tracked'] }]}>
          A LITTLE LEARNING. A LOT OF POSSIBILITY.
        </Text>
        <Text style={[tw`mb-2`, { fontFamily: typography.fontFamily['jakarta-extrabold'], color: colors.text.primary, ...typography.fontSize['type-31'] }]}>
          Make room for what's next.
        </Text>
        <Text style={[tw`mb-7`, { fontFamily: typography.fontFamily.jakarta, color: colors.text.body, ...typography.fontSize['type-15-alt'] }]}>
          Practical AI, one useful step at a time.
        </Text>

        <View style={tw`mb-7`}>
          <StageCrest tone="plum" icon="layers" size="xl" />
        </View>

        {flow.step === 'choice' ? (
          <View style={tw`gap-3`}>
            {flow.erroredProvider && (
              <Alert tone="warning" message="We couldn't finish signing you in. Please try again." />
            )}
            {(['google', 'linkedin'] as const).map((provider) => (
              <ActiveButton
                key={provider}
                variant="secondary"
                label={flow.connectingProvider === provider ? 'Connecting…' : PROVIDER_LABEL[provider]}
                disabled={flow.connectingProvider === provider}
                onPress={() => flow.onContinueWithProvider(provider)}
              />
            ))}
            <GhostLink label="Use your email instead" onPress={flow.onUseEmailInstead} />
            <View style={[tw`w-full`, { height: 1, backgroundColor: colors.path.stage.locked.base }]} />
            <ActiveButton
              variant="secondary"
              label={PROVIDER_LABEL.org}
              icon={<Icon name="building" color={colors.path.btnSecondary.ink} size={18} />}
              onPress={() => flow.onContinueWithProvider('org')}
            />
            <Footer />
          </View>
        ) : flow.step === 'org' ? (
          <View style={tw`gap-4`}>
            <Text style={{ fontFamily: typography.fontFamily['jakarta-bold'], color: colors.text.primary, ...typography.fontSize['type-20-alt'] }}>
              {'Your team\u2019s learning starts here.'}
            </Text>
            <TextField
              label="Work email"
              placeholder="priya@company.com"
              value={flow.email}
              onChangeText={flow.onChangeEmail}
              error={flow.emailError}
              keyboardType="email-address"
            />
            <View
              style={{
                shadowColor: colors.action.primaryShadow,
                shadowOffset: { width: 0, height: 3 },
                shadowOpacity: 1,
                shadowRadius: 0,
                elevation: 3,
              }}
            >
              <ActiveButton
                variant="primary"
                label="Continue with email"
                icon={<Icon name="arrow" color={colors.surface.white} size={18} />}
                onPress={flow.onSubmitOrgEmail}
                fillColor={colors.action.primary}
              />
            </View>
            <GhostLink label="Other sign-in options" onPress={flow.onBackToChoice} />
            <Footer />
          </View>
        ) : (
          <View style={tw`gap-4`}>
            <Text style={{ fontFamily: typography.fontFamily['jakarta-bold'], color: colors.text.primary, ...typography.fontSize['type-20-alt'] }}>
              Welcome back.
            </Text>
            {flow.formError && (
              <Alert tone="warning" message={flow.formError} />
            )}
            <TextField
              label="Email address"
              placeholder="you@example.com"
              value={flow.email}
              onChangeText={flow.onChangeEmail}
              error={flow.emailError}
              keyboardType="email-address"
            />
            {flow.showPasswordField && (
              <TextField
                label="Password"
                value={flow.password}
                onChangeText={flow.onChangePassword}
                error={flow.passwordError}
                secureTextEntry
              />
            )}
            {__DEV__ && (
              <GhostLink label="Test creds" onPress={flow.onFillTestCreds} compact />
            )}
            <View
              style={{
                shadowColor: colors.action.primaryShadow,
                shadowOffset: { width: 0, height: 3 },
                shadowOpacity: 1,
                shadowRadius: 0,
                elevation: 3,
              }}
            >
              <ActiveButton
                variant="primary"
                label={flow.isSubmitting ? 'Signing in…' : flow.ctaLabel}
                disabled={flow.isSubmitting}
                icon={<Icon name="arrow" color={colors.surface.white} size={18} />}
                onPress={flow.onSubmit}
                fillColor={colors.action.primary}
              />
            </View>
            <GhostLink label="Other sign-in options" onPress={flow.onBackToChoice} />
            <Footer />
          </View>
        )}
      </ScrollView>
    </SafeAreaView>
  );
}
</file>

<file path="src/screens/login/useLoginFlow.test.tsx">
import React from 'react';
import ReactTestRenderer, { act } from 'react-test-renderer';
import { validateEmail, validatePassword, useLoginFlow } from './useLoginFlow';
import { ApiError } from '../../data/learnhouse/client';

// `@react-navigation/native`'s Babel-compiled ESM->CJS output exposes
// `useNavigation` as a non-configurable getter, so `jest.spyOn(require(...),
// 'useNavigation')` throws "Cannot redefine property: useNavigation" in this
// project's test environment (verified: Object.getOwnPropertyDescriptor
// reports configurable: false). Mocking the whole module instead sidesteps
// that — the factory returns a plain object with a fresh, writable jest.fn()
// for useNavigation — while keeping the same test intent (stub `reset`).
jest.mock('@react-navigation/native', () => ({
  ...jest.requireActual('@react-navigation/native'),
  useNavigation: jest.fn(),
}));

const mockSignInWithPassword = jest.fn();
const mockSignInWithGoogle = jest.fn();
jest.mock('../../state/useSessionStore', () => ({
  useSessionStore: (selector: (state: unknown) => unknown) =>
    selector({
      signInWithPassword: mockSignInWithPassword,
      signInWithGoogle: mockSignInWithGoogle,
    }),
}));

let mockEveryLogin = true;
jest.mock('../../config/featureFlags', () => ({
  get ONBOARDING_EVERY_LOGIN() { return mockEveryLogin; },
}));
import { useOnboardingStore, emptyAnswers } from '../../state/useOnboardingStore';

const mockGetGoogleAccessToken = jest.fn();
jest.mock('./googleSignIn', () => ({
  getGoogleAccessToken: () => mockGetGoogleAccessToken(),
}));

const mockSaveProfile = jest.fn();
jest.mock('../../data/local/localProfileDb', () => ({
  saveProfile: (...args: unknown[]) => mockSaveProfile(...args),
}));

describe('validateEmail', () => {
  it('accepts a well-formed email', () => {
    expect(validateEmail('a@b.com')).toBeUndefined();
  });
  it.each(['', 'not-an-email', 'a@b', '@b.com', 'a@.com'])('rejects %p', (value) => {
    expect(validateEmail(value)).toBe('Please enter a valid email address');
  });
});

describe('validatePassword', () => {
  it('accepts an 8+ character password', () => {
    expect(validatePassword('longenough')).toBeUndefined();
  });
  it.each(['', 'short'])('rejects %p', (value) => {
    expect(validatePassword(value)).toBe('Please enter a valid password');
  });
});

function Harness({ onReady }: { onReady: (flow: ReturnType<typeof useLoginFlow>) => void }) {
  const flow = useLoginFlow();
  onReady(flow);
  return null;
}

async function flushMicrotasks() {
  await act(async () => {
    await Promise.resolve();
    await Promise.resolve();
  });
}

describe('useLoginFlow state machine', () => {
  const mockReset = jest.fn();
  beforeEach(() => {
    mockReset.mockClear();
    mockEveryLogin = true;
    useOnboardingStore.setState({ answers: emptyAnswers(), completed: false, resumeAvailable: false });
    mockSignInWithPassword.mockReset();
    mockSignInWithGoogle.mockReset();
    mockGetGoogleAccessToken.mockReset();
    mockSaveProfile.mockReset();
    mockSaveProfile.mockResolvedValue(undefined);
    require('@react-navigation/native').useNavigation.mockReturnValue({ reset: mockReset });
    jest.useFakeTimers();
  });
  afterEach(() => {
    jest.useRealTimers();
    jest.restoreAllMocks();
  });

  it('goes choice -> connecting -> errored for the pressed provider only (linkedin stays simulated)', () => {
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onContinueWithProvider('linkedin'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.connectingProvider).toBe('linkedin');
    expect(flow!.erroredProvider).toBeNull();

    act(() => { jest.advanceTimersByTime(1500); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.connectingProvider).toBeNull();
    expect(flow!.erroredProvider).toBe('linkedin');
  });

  it('routes Google through getGoogleAccessToken and lands in erroredProvider when it rejects (unconfigured stub)', async () => {
    mockGetGoogleAccessToken.mockRejectedValue(new Error('Google sign-in is not configured yet'));
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onContinueWithProvider('google'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.connectingProvider).toBe('google');

    await flushMicrotasks();
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.connectingProvider).toBeNull();
    expect(flow!.erroredProvider).toBe('google');
    expect(mockSignInWithGoogle).not.toHaveBeenCalled();
    expect(mockReset).not.toHaveBeenCalled();
  });

  it('signs in with Google and navigates home when the stub/exchange succeeds', async () => {
    mockGetGoogleAccessToken.mockResolvedValue({ email: 'a@b.com', accessToken: 'google-token' });
    mockSignInWithGoogle.mockResolvedValue(undefined);
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onContinueWithProvider('google'); });
    await flushMicrotasks();
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);

    expect(mockSignInWithGoogle).toHaveBeenCalledWith('a@b.com', 'google-token');
    expect(mockReset).toHaveBeenCalledWith({ index: 0, routes: [{ name: 'OnboardingRole' }] });
    expect(flow!.erroredProvider).toBeNull();
  });

  it('moves to the email step and reveals the password field after a valid email submit', () => {
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onUseEmailInstead(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.step).toBe('email');

    act(() => { flow!.onChangeEmail('bad-email'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.emailError).toBe('Please enter a valid email address');
    expect(flow!.showPasswordField).toBe(false);

    act(() => { flow!.onChangeEmail('a@b.com'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.showPasswordField).toBe(true);
    expect(flow!.ctaLabel).toBe('Continue');
  });

  it('navigates home once a valid password is submitted and sign-in succeeds', async () => {
    mockSignInWithPassword.mockResolvedValue(undefined);
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onUseEmailInstead(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onChangeEmail('a@b.com'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);

    act(() => { flow!.onChangePassword('short'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.passwordError).toBe('Please enter a valid password');
    expect(mockReset).not.toHaveBeenCalled();

    act(() => { flow!.onChangePassword('longenough'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.isSubmitting).toBe(true);

    await flushMicrotasks();
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(mockSignInWithPassword).toHaveBeenCalledWith('a@b.com', 'longenough');
    expect(mockReset).toHaveBeenCalledWith({ index: 0, routes: [{ name: 'OnboardingRole' }] });
    expect(flow!.isSubmitting).toBe(false);
  });

  it('shows a mapped form error and does not navigate when sign-in is rejected', async () => {
    mockSignInWithPassword.mockRejectedValue(new ApiError(401, 'Incorrect email or password'));
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onUseEmailInstead(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onChangeEmail('a@b.com'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onChangePassword('longenough'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);

    await flushMicrotasks();
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(mockReset).not.toHaveBeenCalled();
    expect(flow!.formError).toBe('Incorrect email or password.');
    expect(flow!.isSubmitting).toBe(false);

    act(() => { flow!.onChangePassword('longenough2'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.formError).toBeUndefined();
  });

  describe('local profile credentials', () => {
    function signInWithPasswordFlow() {
      let flow!: ReturnType<typeof useLoginFlow>;
      let renderer!: ReactTestRenderer.ReactTestRenderer;
      const rerender = () => renderer.update(<Harness onReady={(f) => { flow = f; }} />);
      act(() => { renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
      act(() => { flow.onUseEmailInstead(); }); rerender();
      act(() => { flow.onChangeEmail('a@b.com'); }); rerender();
      act(() => { flow.onSubmit(); }); rerender();
      act(() => { flow.onChangePassword('longenough'); }); rerender();
      act(() => { flow.onSubmit(); }); rerender();
    }

    it('saves the email and password locally after a successful password sign-in', async () => {
      mockSignInWithPassword.mockResolvedValue(undefined);
      signInWithPasswordFlow();
      await flushMicrotasks();
      expect(mockSaveProfile).toHaveBeenCalledWith('a@b.com'); // username only, never the password
    });

    it('does not save anything when the password sign-in is rejected', async () => {
      mockSignInWithPassword.mockRejectedValue(new ApiError(401, 'Incorrect email or password'));
      signInWithPasswordFlow();
      await flushMicrotasks();
      expect(mockSaveProfile).not.toHaveBeenCalled();
    });

    it('does not save credentials for Google sign-in, which has no password', async () => {
      mockGetGoogleAccessToken.mockResolvedValue({ email: 'a@b.com', accessToken: 't' });
      mockSignInWithGoogle.mockResolvedValue(undefined);
      let flow!: ReturnType<typeof useLoginFlow>;
      act(() => { ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
      act(() => { flow.onContinueWithProvider('google'); });
      await flushMicrotasks();
      expect(mockSaveProfile).not.toHaveBeenCalled();
    });

    it('still navigates into onboarding when the local save fails', async () => {
      jest.spyOn(console, 'error').mockImplementation(() => {});
      mockSignInWithPassword.mockResolvedValue(undefined);
      mockSaveProfile.mockRejectedValue(new Error('disk full'));
      signInWithPasswordFlow();
      await flushMicrotasks();
      expect(mockReset).toHaveBeenCalledWith({ index: 0, routes: [{ name: 'OnboardingRole' }] });
    });
  });

  it('clears a stale emailError when Test creds is used to fill the form', () => {
    let flow: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => {
      renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />);
    });

    act(() => { flow!.onUseEmailInstead(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);

    act(() => { flow!.onChangeEmail('not-an-email'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { flow!.onSubmit(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.emailError).toBe('Please enter a valid email address');

    act(() => { flow!.onFillTestCreds(); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow!.emailError).toBeUndefined();
  });

  it('goes straight Home after sign-in when the flag is off and onboarding is already completed', async () => {
    mockEveryLogin = false;
    useOnboardingStore.setState({ completed: true });
    mockGetGoogleAccessToken.mockResolvedValue({ email: 'a@b.com', accessToken: 't' });
    mockSignInWithGoogle.mockResolvedValue(undefined);
    let flow!: ReturnType<typeof useLoginFlow>;
    act(() => { ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('google'); });
    await flushMicrotasks();
    expect(mockReset).toHaveBeenCalledWith({ index: 0, routes: [{ name: 'HomeScreen' }] });
  });

  it('still shows onboarding when the flag is off but the user has not completed it', async () => {
    mockEveryLogin = false;
    useOnboardingStore.setState({ completed: false });
    mockGetGoogleAccessToken.mockResolvedValue({ email: 'a@b.com', accessToken: 't' });
    mockSignInWithGoogle.mockResolvedValue(undefined);
    let flow!: ReturnType<typeof useLoginFlow>;
    act(() => { ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('google'); });
    await flushMicrotasks();
    expect(mockReset).toHaveBeenCalledWith({ index: 0, routes: [{ name: 'OnboardingRole' }] });
  });

  it.each([
    ['pre-existing stored diagnostic answers', true],
    ['no stored diagnostic answers', false],
  ])('sets resumeAvailable from %s at sign-in', async (_label, hasAnswers) => {
    if (hasAnswers) useOnboardingStore.getState().setDiagnosticAnswer(2, 'check-source');
    mockGetGoogleAccessToken.mockResolvedValue({ email: 'a@b.com', accessToken: 't' });
    mockSignInWithGoogle.mockResolvedValue(undefined);
    let flow!: ReturnType<typeof useLoginFlow>;
    act(() => { ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('google'); });
    await flushMicrotasks();
    expect(useOnboardingStore.getState().resumeAvailable).toBe(hasAnswers);
  });

  it('clears a stale email error when going back from the org step', () => {
    let flow!: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    const render = () => renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('org'); });
    render();
    act(() => { flow.onSubmitOrgEmail(); });
    render();
    expect(flow.emailError).toBe('Please enter a valid email address');
    act(() => { flow.onBackToChoice(); });
    render();
    expect(flow.step).toBe('choice');
    expect(flow.emailError).toBeUndefined();
  });

  it('opens the org step immediately for the org provider', () => {
    let flow!: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    act(() => { renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('org'); });
    renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    expect(flow.step).toBe('org');
    expect(flow.connectingProvider).toBeNull();
  });

  it('org step: rejects an invalid work email, accepts a valid one by continuing to the email step with the password field', () => {
    let flow!: ReturnType<typeof useLoginFlow>;
    let renderer!: ReactTestRenderer.ReactTestRenderer;
    const rerender = () => renderer.update(<Harness onReady={(f) => { flow = f; }} />);
    act(() => { renderer = ReactTestRenderer.create(<Harness onReady={(f) => { flow = f; }} />); });
    act(() => { flow.onContinueWithProvider('org'); }); rerender();

    act(() => { flow.onChangeEmail('nope'); }); rerender();
    act(() => { flow.onSubmitOrgEmail(); }); rerender();
    expect(flow.emailError).toBe('Please enter a valid email address');
    expect(flow.step).toBe('org');

    act(() => { flow.onChangeEmail('priya@company.com'); }); rerender();
    act(() => { flow.onSubmitOrgEmail(); }); rerender();
    expect(flow.step).toBe('email');
    expect(flow.showPasswordField).toBe(true);
    expect(flow.email).toBe('priya@company.com');
  });
});
