    let data!: ReturnType<typeof usePathData>;
    const { updateRenderer } = setupTest((d) => { data = d; });
    await flushMicrotasks();
    updateRenderer();
    expect(data.status).toBe('error');

    await act(async () => {
      data.onRetry();
    });
    await flushMicrotasks();
    updateRenderer();
    expect(mockClearTrailCache).toHaveBeenCalledTimes(1);
  });
});
