<file path="bff/scripts/lh-version.ts">
// bff/scripts/lh-version.ts — which LearnHouse is the BFF talking to?
// Fetches the server's OpenAPI description (public, no token sent), prints its title + version,
// and saves it to docs/evidence/ so the exact API this project ran against is pinned.
// Usage (from bff/):  npx tsx --env-file=.env scripts/lh-version.ts
import { writeFileSync } from 'node:fs';

const base = process.env.LH_BASE_URL;
if (!base) { console.log('LH_BASE_URL is not set in bff/.env'); process.exit(1); }
const apiBase = base.replace(/\/+$/, '');               // e.g. http://host/api/v1
const origin = new URL(apiBase).origin;                 // e.g. http://host
const candidates = [`${origin}/openapi.json`, `${apiBase}/openapi.json`, `${origin}/api/openapi.json`];

(async () => {
  for (const url of candidates) {
    try {
      const res = await fetch(url, { headers: { Accept: 'application/json' }, signal: AbortSignal.timeout(15000) });
      if (!res.ok) { console.log(`${url} -> ${res.status}`); continue; }
      const spec = (await res.json()) as { openapi?: string; info?: { title?: string; version?: string }; paths?: Record<string, unknown> };
      if (!spec?.paths) { console.log(`${url} -> not an OpenAPI document`); continue; }
      const paths = Object.keys(spec.paths);
      const date = new Date().toISOString().slice(0, 10);
      const out = `../docs/evidence/learnhouse-openapi-${date}.json`;
      writeFileSync(out, JSON.stringify(spec, null, 2));
      console.log(`\nLearnHouse API: ${spec.info?.title ?? '?'}  version ${spec.info?.version ?? '?'}  (OpenAPI ${spec.openapi ?? '?'})`);
      console.log(`Server: ${origin}   endpoints: ${paths.length}`);
      const has = (p: string) => (paths.includes(p) ? 'yes' : 'no');
      console.log(`  GET /api/v1/activities/{activity_uuid} ............ ${has('/api/v1/activities/{activity_uuid}')}`);
      console.log(`  POST /api/v1/activities/video ..................... ${has('/api/v1/activities/video')}`);
      console.log(`  POST /api/v1/admin/{org_slug}/progress/.../complete  ${has('/api/v1/admin/{org_slug}/progress/{user_id}/activities/{activity_uuid}/complete')}`);
      console.log(`  content (video/file) routes: ${paths.filter((p) => p.includes('/content')).slice(0, 6).join(', ') || 'none found'}`);
      console.log(`\nSaved: docs/evidence/learnhouse-openapi-${date}.json`);
      return;
    } catch (e) { console.log(`${url} -> ${(e as Error).name}`); }
  }
  console.log('\nNo OpenAPI document found. Open the LearnHouse website, log in as admin, and look for a version in the footer or admin settings.');
})();
</file>

<file path="bff/src/devLogin.ts">
// bff/src/devLogin.ts — DEV-ONLY login, used when LearnHouse /auth/login is not available.
// Maps test emails to LearnHouse user ids SERVER-SIDE (bff/.env), so the app still never
// sends or stores a userId and every request still goes through a session.
// Refuses to start when NODE_ENV=production. Remove once real login works (W4).
import { timingSafeEqual } from 'node:crypto';
import type { LearnHouse } from './learnhouse.ts';

export function parseDevUsers(spec: string | undefined): Map<string, string> {
  // "asha@test.local:101,ravi@test.local:202"
  return new Map((spec ?? '').split(',').map((p) => p.trim()).filter(Boolean).map((p): [string, string] => {
    const i = p.lastIndexOf(':');
    return [p.slice(0, i).toLowerCase(), p.slice(i + 1)];
  }).filter(([e, id]) => e && /^[A-Za-z0-9_-]+$/.test(id)));
}

export function withDevLogin<T extends object>(
  lh: T,
  { users, password, env = process.env.NODE_ENV }: { users: Map<string, string>; password: string | undefined; env?: string },
): T & Pick<LearnHouse, 'login'> {
  if (env === 'production') throw new Error('LH_DEV_LOGIN must not be enabled in production');
  if (!password || password.length < 8) throw new Error('LH_DEV_PASSWORD (8+ chars) is required with LH_DEV_LOGIN');
  if (users.size === 0) throw new Error('LH_DEV_USERS is empty, e.g. you@test.local:123');
  const same = (a: string, b: string) => a.length === b.length && timingSafeEqual(Buffer.from(a), Buffer.from(b));
  return {
    ...lh,
    async login(email: string, pw: string) {
      const id = users.get(String(email).toLowerCase());
      if (!id || !same(String(pw), password)) return null;
      return { learnerId: id, displayName: String(email).split('@')[0], email: String(email).toLowerCase() };
    },
  };
}
</file>

<file path="bff/src/sessions.ts">
// bff/src/sessions.ts — opaque, expiring, in-memory sessions.
// The session is the ONLY source of learner identity for every /me route.
import { randomBytes } from 'node:crypto';
import type { LearnerProfile } from './learnhouse.ts';

export interface Learner {
  learnerId: string;
  displayName: string;
  /** LearnHouse identity read at login (absent for dev login). Server-side only until GET /api/me. */
  profile?: LearnerProfile;
  email?: string;
}
export interface Session extends Learner {
  expiresAt: number;
}
export interface SessionStore {
  create(learner: Learner): { token: string; expiresAt: string };
  get(token: string | null | undefined): Session | null;
  destroy(token: string): void;
}

export function createSessionStore({
  ttlMs = 2 * 60 * 60 * 1000,
  now = () => Date.now(),
}: { ttlMs?: number; now?: () => number } = {}): SessionStore {
  const sessions = new Map<string, Session>();
  return {
    create(learner) {
      const token = randomBytes(32).toString('base64url');
      const expiresAt = now() + ttlMs;
      sessions.set(token, { ...learner, expiresAt });
      return { token, expiresAt: new Date(expiresAt).toISOString() };
    },
    get(token) {
      const s = token ? sessions.get(token) : undefined;
      if (!s) return null;
      if (s.expiresAt <= now()) { sessions.delete(token!); return null; }
      return s;
    },
    destroy(token) { sessions.delete(token); },
  };
}
</file>

<file path="bff/src/util.ts">
// bff/src/util.ts — small shared types and helpers (HTTP adapters, logging).

/** The subset of fetch the adapters use. Real `fetch` satisfies it; tests pass lightweight fakes. */
export type FetchLike = (
  url: string,
  init?: RequestInit,
) => Promise<Pick<Response, 'ok' | 'status' | 'json'>>;

/** An Error that may carry an upstream HTTP status (LearnHouse / Gemini). */
export interface HttpError extends Error {
  status?: number;
  cause?: { code?: string } | unknown;
}

export function httpError(message: string, status?: number): HttpError {
  return Object.assign(new Error(message), { status });
}

/** Network error code (e.g. ECONNREFUSED) from fetch's `cause`, if any. Never includes bodies. */
export function causeCode(e: unknown): string | undefined {
  const cause = (e as { cause?: { code?: unknown } } | null)?.cause;
  return typeof cause?.code === 'string' ? cause.code : undefined;
}

/** Sanitized logging sink. `console` satisfies it; tests pass a silent one. */
export interface Logger {
  info?: (...args: unknown[]) => void;
  warn?: (...args: unknown[]) => void;
