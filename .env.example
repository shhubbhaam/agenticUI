# Dev-only convenience credentials for the login screen's "Test creds"
# button. These MUST be throwaway development credentials only — never
# real user credentials — because EXPO_PUBLIC_* values are inlined into
# the JS bundle at build time and are not runtime-private. The button
# itself is gated behind __DEV__, but a populated .env still bakes
# whatever is here into any build made on this machine. Copy this file
# to .env and fill in throwaway dev-only values; .env is gitignored,
# never commit real credentials here.
EXPO_PUBLIC_TEST_LOGIN_EMAIL=
EXPO_PUBLIC_TEST_LOGIN_PASSWORD=

# Base URL of the LearnHouse instance the app talks to (src/data/learnhouse/).
# Read at build time like the vars above — no trailing slash.
EXPO_PUBLIC_LEARNHOUSE_BASE_URL=

# LearnHouse API exploration script only (scripts/test-learnhouse-api.mjs) —
# NOT read by the app itself, no EXPO_PUBLIC_ prefix needed. This account
# must be an admin/member of at least one org on the instance (the script
# looks up org membership as its second step). Never a real production
# admin account — use a throwaway/test account on your LearnHouse instance.
LH_BASE_URL=
LH_EMAIL=
LH_PASSWORD=
